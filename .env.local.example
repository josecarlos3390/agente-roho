# Copia este archivo como .env.local y rellena tus valores reales.
# .env.local está en .gitignore: no se sube nunca.
#
# Cadena de conexión completa (una sola línea, sin saltos):
MSSQL_CONNSTRING=Server=HOST\INSTANCIA,1433;Database=BASE_DE_DATOS;User Id=USUARIO;Password=CLAVE;TrustServerCertificate=True;Encrypt=True

# Alternativa: por partes, si prefieres no poner todo en una línea
# MSSQL_SERVER=HOST\INSTANCIA,1433
# MSSQL_DATABASE=BASE_DE_DATOS
# MSSQL_USER=USUARIO
# MSSQL_PASSWORD=CLAVE

# Tabla a analizar en la fase 1 (esquema.tabla)
MSSQL_TABLE=dbo.MiTabla
